# Copy to .env (git-ignored). Never commit real keys.
#
# A key is needed ONLY for `hands discover` (the LLM-driven discovery run).
# `hands replay` never calls a model and never reads these. The offline path
# (`hands discover --fake-llm <transcript.jsonl>`) needs no key at all.

# --- Provider selection -----------------------------------------------------
# anthropic | openai. If unset, the provider is auto-detected from whichever
# key is present; if both are set, anthropic wins. Override per run with
# `--provider`.
HANDS_PROVIDER=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
HANDS_MODEL=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional: only if you use a gateway or Azure-compatible endpoint
OPENAI_BASE_URL=
# HANDS_MODEL also overrides the OpenAI model (default: gpt-5.6)

# --- Mock target app --------------------------------------------------------
# Credentials for the LOCAL mock app. These are fake seeded values (see
# README). They are passed to runs as a *sensitive* input via
#   --input password=@env:MOCKBANK_PASSWORD
# so the value never appears in artifacts, logs, or transcripts.
MOCKBANK_USERNAME=teller1
MOCKBANK_PASSWORD=Passw0rd!
