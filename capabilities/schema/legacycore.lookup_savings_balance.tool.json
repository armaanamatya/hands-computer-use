{
  "name": "Look up member savings balance",
  "description": "Sign on, look up the member, and read their savings account current balance.",
  "input_schema": {
    "type": "object",
    "properties": {
      "username": {
        "type": "string",
        "description": "Run input",
        "examples": [
          "teller1"
        ]
      },
      "password": {
        "type": "string",
        "description": "Sensitive credential, supplied from a vault at run time (supplied from a vault; never echoed)"
      },
      "member_id": {
        "type": "string",
        "description": "Run input",
        "examples": [
          "12345"
        ]
      }
    },
    "required": [
      "username",
      "password",
      "member_id"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "savings_balance": {
      "type": "string",
      "description": "Captured output 'savings_balance'"
    }
  },
  "outcome_codes": [
    "MEMBER_NOT_FOUND",
    "ACCOUNT_RESTRICTED",
    "SYSTEM_BUSY",
    "SESSION_EXPIRED",
    "APP_ERROR",
    "VALIDATION_ERROR",
    "SUPERVISOR_OVERRIDE_REQUIRED",
    "UNEXPECTED_CONFIRM"
  ],
  "side_effects": "reads",
  "idempotent": true
}